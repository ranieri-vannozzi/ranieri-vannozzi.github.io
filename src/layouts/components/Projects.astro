---
const { className } = Astro.props
import DynamicIcon from '@/helpers/DynamicIcon'
import projects from '@/config/projects.json'
---

<section
	class={className}
	id="projects"
>
	<div class="rounded border border-border p-12 lg:p-9 h-full">
		<h4 class="text-primary mb-4">{projects.title}</h4>
		<ul class="space-y-6">
			{
				projects.list.map((prj) => (
					<li class="border-b border-border pb-4 last:border-b-0">
						<h5 class="text-md font-bold">{prj.role}</h5>
						<p class="text-muted-foreground">
							{prj.url ? (
								<a
									href={prj.url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 hover:text-primary"
									aria-label={`${prj.company} (opens in a new tab)`}
								>
									{prj.company}
									<DynamicIcon
										className="inline-block text-xs"
										icon="FaArrowUpRightFromSquare"
									/>
								</a>
							) : (
								prj.company
							)}
							<br />
							{prj.period}
						</p>
						<p class="mt-2">{prj.description}</p>
						<ul class="list-disc list-inside space-y-1 mt-2">
							{prj.achievements.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</li>
				))
			}
		</ul>
	</div>
</section>
